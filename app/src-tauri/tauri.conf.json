{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colony Command",
  "version": "0.1.0",
  "identifier": "dev.colonycommand.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Colony Command",
        "visible": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENTNEODAxNDJGMjI4REEKUldUYUtQSkNBZGhUL1NSTXpHMmtubEE0Zk1NVlVIWlplc1FmS3FYRVdMMGErL1hTckU3QnUxTUcK",
      "endpoints": ["https://github.com/t-vaudry/colony-command/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
