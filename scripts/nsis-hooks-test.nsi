; Compiles app/src-tauri/installer-hooks.nsh on its own, so syntax errors and unknown
; variables (-WX makes warnings errors) fail CI. Run by scripts/check-nsis.sh. The real
; installer is generated by Tauri, which provides $UpdateMode and the hook call sites.
!include "LogicLib.nsh"
Name "hooks-test"
OutFile "nsis-hooks-test.exe"
RequestExecutionLevel user
InstallDir "$TEMP\colony-hooks-test"
Var UpdateMode

!include "..\app\src-tauri\installer-hooks.nsh"

Section
  StrCpy $UpdateMode 0
  !insertmacro NSIS_HOOK_PREINSTALL
  !insertmacro NSIS_HOOK_POSTINSTALL
  !insertmacro NSIS_HOOK_PREUNINSTALL
  !insertmacro NSIS_HOOK_POSTUNINSTALL
SectionEnd
